{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "electron-vite/node"
    ]
  }
}
