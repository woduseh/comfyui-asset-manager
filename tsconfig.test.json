{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "src/renderer/src/env.d.ts",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    },
    "types": ["node", "vitest/globals", "electron-vite/node"]
  }
}
